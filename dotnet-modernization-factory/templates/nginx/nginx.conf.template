server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # React Router / SPA fallback. Confirm this is appropriate for the application.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Optional API proxy. Enable only when the platform contract defines the API service.
    # location /api/ {
