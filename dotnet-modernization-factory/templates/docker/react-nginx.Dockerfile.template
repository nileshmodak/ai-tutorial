# Build stage
FROM node:${NODE_VERSION}-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Runtime stage: select an organization-approved Nginx image.
FROM ${NGINX_IMAGE}
COPY --from=build /app/${BUILD_OUTPUT_DIR}/ /usr/share/nginx/html/
COPY templates/nginx/nginx.conf /etc/nginx/conf.d/default.conf
# OpenShift compatibility (arbitrary UID) must be validated against the selected base image.
EXPOSE 8080
